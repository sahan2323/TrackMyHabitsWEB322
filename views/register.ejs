<!-- register.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Register - Task Manager</title>
  <link href="/css/main.css" rel="stylesheet">
  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
  />
</head>
<body class="min-h-screen flex flex-col">

  <%- include("partials/navbar") %>

  <main class="flex flex-col justify-center items-center flex-1 px-4">
    <div class="card bg-base-200 w-full max-w-sm p-6 shadow">
      <h2 class="text-2xl font-bold mb-4 text-center">Create Account</h2>

      <!-- MESSAGE ALERT -->
      <% if (typeof message !== "undefined") { %>
        <div class="alert alert-error mb-4">
          <span><%= message %></span>
        </div>
      <% } %>

      <form action="/register" method="POST" class="flex flex-col gap-4">

        <input name="username" type="text" placeholder="Username" class="input input-bordered w-full" required>

        <input name="email" type="email" placeholder="Email" class="input input-bordered w-full" required>

        <input name="password" type="password" placeholder="Password" class="input input-bordered w-full" required>

        <button class="btn btn-primary w-full">Register</button>
      </form>

      <!-- Switch to Login -->
      <p class="text-center mt-4 text-sm">
        Already have an account?
        <a href="/login" class="text-blue-600 hover:underline font-medium">
          Login
        </a>
      </p>

      <!-- Back Button -->
      <a href="/" class="btn btn-ghost mt-4 w-full">← Back to Home</a>
    </div>
  </main>

  <%- include("partials/footer") %>

</body>
</html>
