<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard</title>
  <link href="/css/main.css" rel="stylesheet">
</head>
<body class="bg-base-200 min-h-screen p-6">

<div class="max-w-6xl mx-auto">

  <!-- Header -->
  <div class="flex flex-col md:flex-row justify-between md:items-center mb-8">
    <h1 class="text-3xl font-bold">Hello, <%= user.username %>!</h1>

    <div class="mt-4 md:mt-0 space-x-2">
      <a href="/tasks/add" class="btn btn-primary">Add Task</a>
      <a href="/logout" class="btn btn-error">Logout</a>
    </div>
  </div>

  <!-- Motivation Section -->
  <div class="card bg-base-100 shadow-md p-6 mb-8 text-center">
    <h2 class="text-xl font-semibold">Track it. Improve it.</h2>
    <p class="text-gray-600 mt-2">Your habits whisper the story of your future.</p>
  </div>

  <!-- Quick Stats -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
  <div class="card bg-base-100 shadow-md p-5 text-center">
    <h2 class="text-lg font-semibold">Total Tasks</h2>
    <p class="text-3xl font-bold mt-2"><%= tasks.length %></p>
  </div>

  <div class="card bg-base-100 shadow-md p-5 text-center">
    <h2 class="text-lg font-semibold">Pending Tasks</h2>
    <p class="text-3xl font-bold mt-2">
      <%= tasks.filter(t => t.status === 'pending').length %>
    </p>
  </div>

  <div class="card bg-base-100 shadow-md p-5 text-center">
    <h2 class="text-lg font-semibold">Completed Tasks</h2>
    <p class="text-3xl font-bold mt-2">
      <%= tasks.filter(t => t.status === 'completed').length %>
    </p>
  </div>
</div>


  <!-- Task List -->
  <% if (tasks.length === 0) { %>
    <div class="card bg-base-100 shadow-md p-10 text-center">
      <p class="text-gray-500 text-lg">You don’t have any habits yet. Start building one!</p>
    </div>

  <% } else { %>

    <h2 class="text-2xl font-bold mb-4">Your Habits</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% tasks.forEach(task => { %>

        <div class="card shadow-md p-5 <%= task.status === 'completed' ? 'bg-green-100' : 'bg-base-100' %>">
          <h3 class="text-xl font-semibold <%= task.status === 'completed' ? 'line-through text-gray-500' : '' %>">
            <%= task.title %>
          </h3>

          <p class="text-gray-600 mt-2 <%= task.status === 'completed' ? 'line-through text-gray-400' : '' %>">
            <%= task.description || '-' %>
          </p>

          <div class="mt-3 text-sm text-gray-500">
            <p>Due: <%= task.dueDate ? new Date(task.dueDate).toDateString() : 'N/A' %></p>
            <p>Status: <%= task.status %></p>
          </div>

          <div class="mt-4 flex flex-wrap gap-3">
            <% if (task.status === 'pending') { %>
              <form action="/tasks/complete/<%= task.id %>" method="POST">
                <button type="submit" class="btn btn-sm btn-success">Mark Completed</button>
              </form>
            <% } %>

            <a href="/tasks/edit/<%= task.id %>" class="btn btn-sm btn-outline">Edit</a>
            <a href="/tasks/delete/<%= task.id %>" class="btn btn-sm btn-error">Delete</a>
          </div>
        </div>

      <% }) %>
    </div>

  <% } %>
</div>

</body>
</html>
