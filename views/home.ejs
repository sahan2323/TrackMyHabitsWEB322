<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Task Manager</title>
  <link href="/css/main.css" rel="stylesheet">
  <link
  rel="stylesheet"
  href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
/>

</head>
<body class="min-h-screen flex flex-col bg-base-200">

  <%- include("partials/navbar") %>

  <!-- Hero Section -->
  <section class="flex flex-col items-center justify-center flex-1 px-6 py-16 text-center">
    <h1 class="text-5xl font-bold mb-4">Build Better Habits. One Day at a Time.</h1>
    <p class="text-lg text-gray-600 mb-8 max-w-xl">
      Track your tasks, stay accountable, and turn small daily habits into long-term growth.
    </p>

    <a href="/login" class="btn btn-primary px-6 text-lg">Start Tracking</a>
  </section>

  <!-- Features Section -->
<section class="px-6 py-12 bg-base-100">
  <h2 class="text-3xl font-bold text-center mb-10">Why Use Our Tracker?</h2>
  
  <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">

    <!-- Card 1 -->
    <div class="card bg-base-100 shadow-md overflow-hidden">
      <div class="h-48 w-full">
        <img src="/images/productivity.jpg" alt="Daily Productivity" class="w-full h-full object-cover">
      </div>
      <div class="p-6 text-center">
        <h3 class="text-xl font-semibold mb-2">Daily Productivity</h3>
        <p class="text-gray-600">Stay consistent by completing small tasks every day.</p>
      </div>
    </div>

    <!-- Card 2 -->
    <div class="card bg-base-100 shadow-md overflow-hidden">
      <div class="h-48 w-full">
        <img src="/images/health.jpg" alt="Healthy Habits" class="w-full h-full object-cover">
      </div>
      <div class="p-6 text-center">
        <h3 class="text-xl font-semibold mb-2">Healthy Habits</h3>
        <p class="text-gray-600">Build routines around fitness, wellness, sleep, study, and more.</p>
      </div>
    </div>

    <!-- Card 3 -->
    <div class="card bg-base-100 shadow-md overflow-hidden">
      <div class="h-48 w-full">
        <img src="/images/progress.jpg" alt="Clear Progress" class="w-full h-full object-cover">
      </div>
      <div class="p-6 text-center">
        <h3 class="text-xl font-semibold mb-2">Clear Progress</h3>
        <p class="text-gray-600">Visualize your growth and stay motivated with simple progress stats.</p>
      </div>
    </div>

  </div>
</section>


  <%- include("partials/footer") %>
</body>
</html>
